# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- Secrets / signing (never commit) ----
keystore.properties
*.jks
*.keystore
local.properties
*.p12
*.mobileprovision

# ---- Node / JS (web + react-native) ----
# No trailing slash: v2's RN package symlinks node_modules at the v1 package's copy,
# and a trailing slash matches directories only, so the symlink would be committed.
node_modules
dist/
*.tgz
npm-debug.log*
yarn-error.log
.expo/
.expo-shared/

# ---- Android / Gradle ----
.gradle/
build/
# Android Studio profiler dumps. NOTE: this pattern also matched `docs/captures/` and silently
# left the live #27a wire captures — the ground truth for the agentic contract (docs/02 §#27a) —
# untracked. Re-included below; keep the negation if this rule is ever touched.
captures/
!docs/captures/
.cxx/
*.apk
*.aar
*.ap_
*.dex

# ---- iOS / Swift / Xcode ----
.build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
.swiftpm/
ios/dist/

# ---- SDK build outputs / distribution proofs ----
# The packaged example apps install from generated tarballs — regenerate, don't commit.
**/example-packaged/node_modules/
**/example-packaged/dist/
**/dist-bundle/

# generated by tools/guide-gen/build.py (the JSON IS tracked; the HTML is not)
tools/guide-gen/farmerchat-sdk-docs.html
tools/guide-gen/__pycache__/
