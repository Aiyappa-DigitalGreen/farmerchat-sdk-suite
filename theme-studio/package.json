{
  "name": "farmerchat-theme-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Live theme + platform playground for the FarmerChat SDK — preview the chat screen and export ready-to-paste FarmerChatConfig. Built with React + Vite + shadcn/ui.",
  "scripts": {
    "dev": "vite --port 4700",
    "start": "vite --port 4700",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4700",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.474.0",
    "next-themes": "^0.4.4",
    "radix-ui": "^1.6.5",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
