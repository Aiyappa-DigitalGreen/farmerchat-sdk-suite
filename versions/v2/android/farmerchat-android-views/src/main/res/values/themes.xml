<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FarmerChatSdk" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fc_green700</item>
        <item name="colorOnPrimary">@color/fc_white</item>
        <item name="colorPrimaryContainer">@color/fc_green800</item>
        <item name="colorOnPrimaryContainer">@color/fc_white</item>
        <item name="colorSecondary">@color/fc_green500</item>
        <item name="colorOnSecondary">@color/fc_green950</item>
        <item name="colorError">@color/fc_red500</item>
        <item name="android:colorBackground">@color/fc_surface_primary</item>
        <item name="colorSurface">@color/fc_surface_secondary</item>
        <item name="colorOnSurface">@color/fc_foreground_primary</item>
        <item name="android:windowBackground">@color/fc_surface_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Compose parity, and the single biggest source of vertical drift in this flavour.
             Compose 1.6+ defaults `includeFontPadding` to FALSE; a TextView defaults it to TRUE
             and adds ~3dp of leading per line. Every views text row therefore ran ~8px taller
             than the app's, and the error ACCUMULATED down a screen — 146px by the bottom of
             Help. Applied through the default TextView style so it reaches every row at once.
             Measured on LanguageChooser: rows went from +8px each to within 1-2px of the app. -->
        <item name="android:textViewStyle">@style/FcTextView</item>
    </style>

    <style name="FcTextView" parent="Widget.AppCompat.TextView">
        <item name="android:includeFontPadding">false</item>
        <!-- The reason views' text weights did not match the app's. `android:textFontWeight`
             only INTERPOLATES against a named family; with the default typeface it snaps to
             normal/bold, so a nominal 600 rendered at 400's width. Measured on the Settings
             section title (same string, same 17sp, same y): app 189px, views 180px at bare
             `textFontWeight=600`, 199px at `bold`, and **191px** once an explicit
             `sans-serif` family is present. Applied here so every TextView in the flavour
             resolves weights the way Compose does. -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.FarmerChatSdk.LegalDialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowBackground">@color/fc_surface_secondary</item>
    </style>
</resources>
