    <!-- Brand-palette FOREGROUNDS. These exist because the drawer (and any other surface painted
         with a fc_brand_* background) needs text colours from the BRAND palette, not the neutral
         one. The two palettes share member names — `surfaceSecondary` is #FFFFFF in the neutral
         palette and #08361B in the brand palette — and the drawer was built against the neutral
         set, which is why it rendered as a white panel where the app's is dark green.
         Values mirror compose `BrandSemanticColors` (theme/Color.kt). -->
    <color name="fc_brand_foreground_primary">#FFFFFF</color>
    <color name="fc_brand_foreground_secondary">#00C950</color>
    <!-- surfacePrimary (#008236) at 20% alpha — the drawer divider in compose Drawer.kt:291 -->
    <color name="fc_brand_divider">#33008236</color>
    <color name="fc_accent">#00C950</color>
    <!-- fc_accent at 28% / 0% — the PersonalizationTag glow stops. Override with fc_accent. -->
    <color name="fc_accent_28">#4700C950</color>
    <color name="fc_accent_0">#0000C950</color>
    <!-- An accent icon drawn ON the brand surface (composer camera / mic). Defaults to the accent;
