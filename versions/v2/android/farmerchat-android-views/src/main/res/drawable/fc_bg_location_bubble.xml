<?xml version="1.0" encoding="utf-8"?>
<!--
  Location chat bubble (2.0.0). Same asymmetric silhouette as fc_bg_user_bubble — three
  corners rounded (Radius.XL = 20dp), bottom-right sharp — because the bubble stands in for
  the farmer's own reply. Compose parity: components/LocationChatBubble.kt uses bottomEnd = 0.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/fc_surface_reading_secondary" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="20dp"
        android:bottomRightRadius="0dp" />
</shape>
