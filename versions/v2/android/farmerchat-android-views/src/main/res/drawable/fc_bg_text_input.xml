<?xml version="1.0" encoding="utf-8"?>
<!-- App form TextInput (OutlinedTextField): surfaceSecondary, Radius.MD, 1dp borderDefault,
     borderActive while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_surface_secondary"/>
            <stroke android:width="2dp" android:color="@color/fc_border_active"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_surface_secondary"/>
            <stroke android:width="1dp" android:color="@color/fc_border_default"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
