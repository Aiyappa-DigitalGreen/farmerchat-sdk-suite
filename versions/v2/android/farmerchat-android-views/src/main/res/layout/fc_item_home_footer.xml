<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="40dp">

    <!-- App FeedFooter.kt: a 40sp waving hand (dark skin tone), not the logo mark. The wave +
         fade-in run from HomeFeedAdapter when the footer is bound. -->
    <TextView
        android:id="@+id/fcFeedFooterWave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/fcFeedFooterText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Have a great day, come back tomorrow" />
</LinearLayout>
