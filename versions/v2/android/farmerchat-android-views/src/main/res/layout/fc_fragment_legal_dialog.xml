<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_surface_secondary"
    android:orientation="vertical">

    <!-- Same hand-rolled 56dp white bar Auth had, and the same fix: the shared brand-green
         include (compose uses `DefaultAppBar` here too — LegalContentScreen.kt:62). -->
    <include
        android:id="@+id/fcLegalAppBar"
        layout="@layout/fc_view_appbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/fcLegalWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/fcLegalProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
