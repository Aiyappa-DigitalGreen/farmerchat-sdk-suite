<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fcAppBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/fc_green700">

    <!-- Hidden by DEFAULT. The app draws this sunbeam glow on HOME only; its Settings bar
         passes `showGlow = false` (app SettingsScreen.kt:121) and measures flat #008236, as does
         the compose flavour. Views showed it on every screen, which made the app bar the single
         largest source of pixel difference on Settings — 37,180 differing pixels, 32% of the
         screen's total. HomeFragment turns it back on. -->
    <ImageView
        android:id="@+id/fcAppBarGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:visibility="gone"
        android:src="@drawable/fc_glow_yellow" />

    <ImageButton
        android:id="@+id/fcAppBarLeft"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="@drawable/fc_bg_appbar_chip"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/fc_ic_menu"
        app:tint="@color/fc_white" />

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
        android:id="@+id/fcAppBarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:fcTextColor="@color/fc_white"
        app:fcMaxLines="1"
        app:fcTextSizeSp="18"
        app:fcTextWeight="700"
        app:fcEllipsize="true" />

    <ImageView
        android:id="@+id/fcAppBarLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/fc_logo_mark"
        android:visibility="gone"
        app:tint="@color/fc_white" />

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
        android:id="@+id/fcAppBarRightLabel"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fc_bg_appbar_chip"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:fcTextColor="@color/fc_white"
        android:visibility="gone"
        app:fcTextSizeSp="15"
        app:fcTextWeight="700"
        app:fcTextAlign="center" />

    <!-- Weather pill (Home only) -->
    <!--
      CHAT_ONLY action slot: with the drawer hidden there is nowhere else to reach
      Past Advice or the language chooser, so they sit here. Both default to GONE and
      are shown by ChatFragment only when the drawer is off and the feature is enabled.
      Placed before the weather pill so `end|center_vertical` stacking puts weather
      outermost when both are somehow visible.
    -->
    <LinearLayout
        android:id="@+id/fcAppBarActions"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/fcAppBarHistory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fc_icon_timer"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/fcAppBarLanguage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fc_icon_language"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fcAppBarWeather"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fc_bg_weather_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fcAppBarWeatherIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/fc_weather_sunclouds" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
            android:id="@+id/fcAppBarWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:fcTextColor="@color/fc_white"
            app:fcTextSizeSp="15"
            app:fcTextWeight="700" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/fc_ic_chevron_right"
            app:tint="@color/fc_green500" />
    </LinearLayout>
</FrameLayout>
