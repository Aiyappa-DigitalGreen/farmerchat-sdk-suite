<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">
    <!-- Bottom = the app's Spacer(24.dp) after the subtitle (LanguageScreen.kt). Measured
         2026-09-28 on 1440x3120: the first row text sat 21px (6dp) high at 18dp. -->

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/fc_logo_mark"
        app:tint="@color/fc_border_active" />
        <!-- App parity (LanguageScreen.kt:373): the mark is tinted borderActive — brand GREEN.
             Views tinted it foreground_primary, drawing a BLACK flower, exactly as the compose
             flavour did before 2026-09-08. -->

    <TextView
        android:id="@+id/fcLanguageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Choose your language" />

    <TextView
        android:id="@+id/fcLanguageSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/fc_foreground_secondary"
        android:textSize="17sp"
        tools:text="You can change this later" />
</LinearLayout>
