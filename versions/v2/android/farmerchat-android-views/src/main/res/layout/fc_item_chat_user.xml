<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="84dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="end">

    <!-- App UserChatBubble.kt, image only (no caption / voice): no bubble, a bare 220x160dp
         photo clipped to 16dp. -->
    <ImageView
        android:id="@+id/fcUserImageOnly"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:background="@drawable/fc_clip_r16"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fcUserBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/fc_bg_user_bubble"
        android:orientation="vertical"
        android:maxWidth="290dp"
        android:padding="16dp">

        <!-- App UserChatBubble.kt wide banner: INSIDE the bubble, full width, 16:9 (height set
             in code), clipped to 16dp, caption 10dp below. -->
        <ImageView
            android:id="@+id/fcUserBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/fc_clip_r16"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- App PhotoThumbnail(size = 80), clipped to 8dp. -->
        <ImageView
            android:id="@+id/fcUserThumb"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/fc_clip_r8"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.VoiceClipView
            android:id="@+id/fcUserVoice"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fcUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fc_foreground_primary"
            android:textSize="17sp"
            android:lineSpacingExtra="8sp"
            tools:text="What is wrong with my crop?" />
    </LinearLayout>
</LinearLayout>
