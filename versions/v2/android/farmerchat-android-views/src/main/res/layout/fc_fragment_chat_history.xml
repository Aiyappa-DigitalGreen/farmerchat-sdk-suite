<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_green700"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/fcHistoryAppBar"
        layout="@layout/fc_view_appbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fc_surface_primary">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fcHistoryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.LogoSpinnerView
            android:id="@+id/fcHistoryLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fcHistoryErrorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                android:id="@+id/fcHistoryErrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:fcTextColor="@color/fc_foreground_primary"
                app:fcTextSizeSp="15"
                app:fcTextAlign="center" />

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
                android:id="@+id/fcHistoryRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
