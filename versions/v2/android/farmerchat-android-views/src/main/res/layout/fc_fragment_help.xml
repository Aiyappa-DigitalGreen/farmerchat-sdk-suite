<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_green700"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/fcHelpAppBar"
        layout="@layout/fc_view_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fc_surface_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                android:id="@+id/fcHelpFaqTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fcTextColor="@color/fc_foreground_primary"
                app:fcTextSizeSp="17"
                app:fcLineHeightSp="22"
                app:fcTextWeight="600" />

            <LinearLayout
                android:id="@+id/fcHelpFaqCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fc_bg_card_md"
                android:orientation="vertical" 
                android:divider="@drawable/fc_divider_list"
                android:showDividers="middle"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"/>

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                android:id="@+id/fcHelpMoreTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:fcTextColor="@color/fc_foreground_primary"
                app:fcTextSizeSp="17"
                app:fcLineHeightSp="22"
                app:fcTextWeight="600" />

            <LinearLayout
                android:id="@+id/fcHelpMoreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fc_bg_card_md"
                android:orientation="vertical" 
                android:divider="@drawable/fc_divider_list"
                android:showDividers="middle"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"/>

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                android:id="@+id/fcHelpVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                app:fcTextColor="@color/fc_foreground_secondary"
                app:fcTextSizeSp="13"
                app:fcTextAlign="center" />

            <!-- Compose parity (HelpScreen.kt:251): BOTH footer lines are foregroundSecondary.
                 This was foreground_tertiary (#D4D4D8) on a near-white surface — the copyright
                 rendered, but was effectively unreadable. -->
            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                android:id="@+id/fcHelpCopyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                app:fcTextColor="@color/fc_foreground_secondary"
                app:fcTextSizeSp="13"
                app:fcTextAlign="center" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
