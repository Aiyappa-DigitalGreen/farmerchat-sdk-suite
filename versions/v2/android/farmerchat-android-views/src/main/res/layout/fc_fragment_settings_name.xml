<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_green700"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/fcSettingsNameAppBar"
        layout="@layout/fc_view_appbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fc_surface_primary"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Compose parity (SettingsNameScreen.kt:146 → Form.kt TextInput): the field carries a
             LABEL above it — labelMedium, foregroundPrimary, 8dp clear of the input. Views had
             no label at all, so the screen opened with an unlabelled box. -->
        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
            android:id="@+id/fcSettingsNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:fcTextColor="@color/fc_foreground_primary"
            app:fcTextSizeSp="15"
            app:fcTextWeight="700" />

        <EditText
            android:id="@+id/fcSettingsNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fc_bg_input_field_states"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:padding="16dp"
            android:textColor="@color/fc_foreground_primary"
            android:textColorHint="@color/fc_form_placeholder"
            android:textSize="19sp"
            android:importantForAutofill="no"
            tools:hint="Enter your name" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
            android:id="@+id/fcSettingsNameSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ToastView
            android:id="@+id/fcSettingsNameToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
