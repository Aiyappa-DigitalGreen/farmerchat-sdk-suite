<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/fcSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:src="@drawable/fc_boot_bg" />

    <ImageView
        android:id="@+id/fcSplashLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/fc_logo_mark"
        app:tint="@color/fc_white" />

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ToastView
        android:id="@+id/fcSplashToast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:visibility="gone" />
</FrameLayout>
