<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!--
      Agentic (2.0.0) EXCLUSIVE alignment surface (clarify / confirm / escalate / capability
      prompt). When visible it REPLACES the answer and owns the whole message area: no answer
      text, no action row, no related questions.
    -->
    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.AlignmentSurfaceView
        android:id="@+id/fcAiAlignmentExclusive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fcAiText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="17sp"
        android:lineSpacingExtra="4dp"
        tools:text="Here is the advice for your crop..." />

    <!--
      Agentic (2.0.0) stream status: the tool-progress label while streaming, or the transient
      "paused, resuming" stall hint. The two states are mutually exclusive, so one spinner serves
      both (app parity: LogoSpinnerHorizontal).
    -->
    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.LogoSpinnerView
        android:id="@+id/fcAiStreamStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:visibility="gone" />

    <!-- Agentic (2.0.0) interrupted stream: preserved partial text above, retry here. -->
    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.StreamErrorCardView
        android:id="@+id/fcAiStreamError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fcAiReadFull"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/fc_bg_primary_button"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/fc_white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Read full advice" />

    <!--
      Agentic (2.0.0) accuracy note. App parity (ChatResponseActions.kt:96): on an agentic answer
      the note sits ABOVE the action row, with the info glyph tinted `buttonPrimaryAccent`. The
      views flavour had no warning row at all — neither here nor in the legacy branch — so every
      answer shipped without the "AI may be wrong / Local conditions may vary" line the app shows.
    -->
    <LinearLayout
        android:id="@+id/fcAiWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fcAiWarningIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/fc_icon_info"
            android:tint="@color/fc_accent" />

        <TextView
            android:id="@+id/fcAiWarningText"
            style="@style/FcChatAiWarningText"
            android:layout_weight="1"
            tools:text="AI may be wrong. Please double-check." />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fcAiActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/fcActionShare"
            style="@style/FcChatAction"
            android:drawableStart="@drawable/fc_icon_share"
            tools:text="Share" />

        <TextView
            android:id="@+id/fcActionDownload"
            style="@style/FcChatAction"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/fc_icon_save"
            tools:text="Save" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/fcActionListen"
                style="@style/FcChatAction"
                android:drawableStart="@drawable/fc_ic_play"
                tools:text="Listen" />

            <ProgressBar
                android:id="@+id/fcActionListenLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_gravity="start|center_vertical"
                android:indeterminateTint="@color/fc_green500"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/fcAiFollowUpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/fc_foreground_secondary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Related questions" />

    <LinearLayout
        android:id="@+id/fcAiFollowUps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!--
      Agentic (2.0.0) ADDITIVE alignment surface (gender-select / commodity-confirm): a nudge
      BELOW a real answer. The answer above keeps its own action row and related questions.

      ORDER IS APP PARITY. The app renders the answer, then `ChatResponseActions` (the "Local
      conditions may vary" caption + Share/Listen + follow-ups), and only THEN this nudge
      (`ChatThreadContent.kt` — the nudge sits after the interrupted/actions if-else chain).
      This view used to sit ABOVE the warning and action rows, so a farmer saw
      "Help us tailor your advice" before the answer's own caption and buttons — the two blocks
      transposed. Same defect the compose flavour had; both fixed 2026-09-08.
    -->
    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.AlignmentSurfaceView
        android:id="@+id/fcAiAlignmentAdditive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />
</LinearLayout>
