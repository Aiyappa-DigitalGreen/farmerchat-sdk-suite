<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/fcAiText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="17sp"
        android:lineSpacingExtra="4dp"
        tools:text="Here is the advice for your crop..." />

    <TextView
        android:id="@+id/fcAiReadFull"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/fc_bg_primary_button"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/fc_white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Read full advice" />

    <LinearLayout
        android:id="@+id/fcAiActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/fcActionShare"
            style="@style/FcChatAction"
            android:drawableStart="@drawable/fc_icon_share"
            tools:text="Share" />

        <TextView
            android:id="@+id/fcActionDownload"
            style="@style/FcChatAction"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/fc_icon_save"
            tools:text="Save" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/fcActionListen"
                style="@style/FcChatAction"
                android:drawableStart="@drawable/fc_ic_play"
                tools:text="Listen" />

            <ProgressBar
                android:id="@+id/fcActionListenLoading"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/fc_green500"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/fcAiFollowUpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/fc_foreground_secondary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Related questions" />

    <LinearLayout
        android:id="@+id/fcAiFollowUps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
