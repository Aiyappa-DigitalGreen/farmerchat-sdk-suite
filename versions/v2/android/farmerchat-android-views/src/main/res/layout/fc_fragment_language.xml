<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_surface_primary">

    <LinearLayout
        android:id="@+id/fcLanguageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fcLanguageList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fc_bg_rounded_top"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/fcLanguageTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/fc_foreground_secondary"
                android:textSize="15sp"
                tools:text="Practical advice for your crops and animals" />

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
                android:id="@+id/fcLanguageStartButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/fcLanguageLegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/fc_foreground_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="By continuing you agree to our" />

            <TextView
                android:id="@+id/fcLanguageLegalLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/fc_foreground_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Terms of use · Privacy policy" />
        </LinearLayout>
    </LinearLayout>

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.LogoSpinnerView
        android:id="@+id/fcLanguageLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
