<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Insets are applied in FullScreenMessageView (not fitsSystemWindows): the app's glow bar
         extends BEHIND the status bar, so only the bar's content is pushed down. -->
    <LinearLayout
        android:id="@+id/fcFsmRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- App bar with yellow glow -->
        <FrameLayout
            android:id="@+id/fcFsmAppBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/fcFsmGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"
                android:src="@drawable/fc_glow_yellow" />

            <ImageButton
                android:id="@+id/fcFsmLeftButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:background="@drawable/fc_bg_appbar_chip_round"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/fc_ic_back"
                app:tint="@color/fc_white" />

            <TextView
                android:id="@+id/fcFsmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="64dp"
                android:layout_marginEnd="64dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/fc_white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Sign up" />

            <TextView
                android:id="@+id/fcFsmRightLabel"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/fc_bg_appbar_chip_round"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/fc_white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Skip" />
        </FrameLayout>

        <!-- Illustration: capsule-clipped, max 300dp wide, 300:450 aspect -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:id="@+id/fcFsmIllustrationClip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/fc_bg_capsule">

                <ImageView
                    android:id="@+id/fcFsmIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/fcFsmMainMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textColor="@color/fc_white"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Save your questions and answers" />

        <TextView
            android:id="@+id/fcFsmSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textColor="@color/fc_white"
            android:textSize="17sp"
            tools:text="We'll save your chats so you can continue later." />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
            android:id="@+id/fcFsmPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/fcFsmSecondaryCta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/fc_white"
            android:textSize="17sp"
            android:visibility="gone"
            tools:text="Skip" />
    </LinearLayout>
</merge>
