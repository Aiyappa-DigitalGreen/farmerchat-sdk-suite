<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/fc_bg_card"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fcCardImageFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fcCardImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:shapeAppearanceOverlay="@style/FcShapeRounded16" />

        <!-- AI image placeholders (app parity: AIGeneratingImageOverlay / AIGeneratedGradient) -->
        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.AiImageOverlayView
            android:id="@+id/fcCardImageOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- App ViewCountBadge: TopEnd, 12dp in, 28dp tall, scrim, 8dp/10dp sides, 20dp
             brand-secondary eye, 5dp, labelSmall count in brand-primary. -->
        <LinearLayout
            android:id="@+id/fcCardViewBadge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/fc_bg_view_count_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/fc_ic_visibility"
                app:tint="@color/fc_brand_foreground_secondary" />

            <TextView
                android:id="@+id/fcCardViewCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/fc_brand_foreground_primary"
                android:textSize="13sp"
                android:textFontWeight="600"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </FrameLayout>

    <!-- App PersonalizationTag (text-only cards with meta.asset_name): 18dp top / 18dp start /
         24dp end, a 36dp glow box holding the 22dp icon, 6dp, labelMedium label. Followed by
         a 10dp spacer; without a tag the card opens with 18dp. -->
    <LinearLayout
        android:id="@+id/fcCardPersonalization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clipChildren="false">

            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="-12dp"
                android:background="@drawable/fc_glow_personalization" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/fc_icon_personalization" />
        </FrameLayout>

        <TextView
            android:id="@+id/fcCardPersonalizationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/fc_foreground_primary"
            android:textSize="15sp"
            android:textFontWeight="600"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Stays a TextView deliberately. `FcText` in a RECYCLED row was measured and rejected:
         one composition host per row took scroll jank from 0.00% to 3.25% (legacy 17.86% ->
         96.19%) and the 99th-percentile frame from 24ms to 73ms — 4x the 16.7ms budget. FcText
         is for static screens only; see FcText.kt and docs/04. -->
    <TextView
        android:id="@+id/fcCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="19sp"
        tools:text="How to protect maize from armyworm" />

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
        android:id="@+id/fcCardCta"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp" />
</LinearLayout>
