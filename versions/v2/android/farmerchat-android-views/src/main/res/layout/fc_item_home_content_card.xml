<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/fc_bg_card"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fcCardImageFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fcCardImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:shapeAppearanceOverlay="@style/FcShapeRounded16" />

        <!-- AI image placeholders (app parity: AIGeneratingImageOverlay / AIGeneratedGradient) -->
        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.AiImageOverlayView
            android:id="@+id/fcCardImageOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/fcCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="19sp"
        tools:text="How to protect maize from armyworm" />

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
        android:id="@+id/fcCardCta"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp" />
</LinearLayout>
