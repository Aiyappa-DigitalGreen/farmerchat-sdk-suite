<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fcOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/fcOverlayScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fc_scrim" />

    <!-- Text input bar -->
    <LinearLayout
        android:id="@+id/fcTextInputPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/fc_bg_rounded_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/fcTextInputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/fc_bg_input_field"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/fc_foreground_primary"
            android:textColorHint="@color/fc_foreground_tertiary"
            android:textSize="16sp"
            android:importantForAutofill="no"
            tools:hint="Ask about your farm..." />

        <ImageButton
            android:id="@+id/fcTextInputSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/fc_bg_circle_brand"
            android:contentDescription="@null"
            android:src="@drawable/fc_icon_send"
            app:tint="@color/fc_white" />
    </LinearLayout>

    <!-- Voice input panel: app VoiceInput.kt sheet (16dp top corners, 8/16/8 padding, a 320dp
         body). The body is VoiceRecorderView; the nav-bar inset is added by fcOverlayRoot. -->
    <FrameLayout
        android:id="@+id/fcVoicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/fc_bg_voice_sheet"
        android:clickable="true"
        android:focusable="false"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.VoiceRecorderView
            android:id="@+id/fcVoiceRecorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- Photo input panel: app PhotoInput.kt — no title; one 168dp row of two tiles
         (Camera · Photos) on surfaceTertiary, 16dp corners; sheet 12/24/12/8 padding. -->
    <LinearLayout
        android:id="@+id/fcPhotoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/fc_bg_voice_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/fcPhotoCamera"
            style="@style/FcPhotoTile">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/fc_icon_camera"
                app:tint="@color/fc_foreground_primary" />
            <TextView
                android:id="@+id/fcPhotoCameraLabel"
                style="@style/FcPhotoTileLabel"
                tools:text="Camera" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fcPhotoGallery"
            style="@style/FcPhotoTile"
            android:layout_marginStart="12dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/fc_ic_photo_library"
                app:tint="@color/fc_foreground_primary" />
            <TextView
                android:id="@+id/fcPhotoGalleryLabel"
                style="@style/FcPhotoTileLabel"
                tools:text="Photos" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
