<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_green700">

    <!-- App LogoAppBar: Glow(Yellow) 80dp at the SCREEN top ("always on"), so it lights the
         status-bar area and the top of the bar. Drawn behind the (now transparent) bar. -->
    <ImageView
        android:id="@+id/fcChatTopGlow"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/fc_glow_yellow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/fcChatAppBar"
            layout="@layout/fc_view_appbar" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/fc_surface_reading">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fcChatList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="16dp" />

            <!-- Empty-chat placeholder (SDK addition; compose ChatEmptyState / web parity):
                 centred over the list's viewport, outside the list so it never scrolls. Its
                 bottom padding tracks the list's (the floating composer's reserve) so the
                 composer never overlaps it. Driven by ChatFragment.updateEmptyState. -->
            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ChatEmptyStateView
                android:id="@+id/fcChatEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- App ScrollIndicator: after a new answer with more below, a 40dp accent circle
                 bounces three times above the composer, then fades. Tap = scroll to the end. -->
            <ImageView
                android:id="@+id/fcChatScrollIndicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|center_horizontal"
                android:alpha="0"
                android:background="@drawable/fc_bg_circle_accent"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/fc_icon_arrow_down"
                android:visibility="gone"
                app:tint="@color/fc_button_primary_foreground" />

            <org.digitalgreen.farmerchat.sdk.views.internal.widgets.LogoSpinnerView
                android:id="@+id/fcChatLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Follow-up Photo / Speak / Type row (chat variant: 72dp on green surface) -->
        <LinearLayout
            android:id="@+id/fcChatInputButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fc_green700"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/fcChatInputPhoto"
                style="@style/FcInputButton"
                android:layout_height="72dp"
                android:paddingTop="13dp"
                android:paddingBottom="9dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/fc_icon_camera" />
                <TextView
                    android:id="@+id/fcChatInputPhotoLabel"
                    style="@style/FcInputButtonLabel"
                    android:layout_marginTop="4dp"
                    tools:text="Photo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fcChatInputSpeak"
                style="@style/FcInputButton"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:paddingTop="13dp"
                android:paddingBottom="9dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/fc_icon_mic" />
                <TextView
                    android:id="@+id/fcChatInputSpeakLabel"
                    style="@style/FcInputButtonLabel"
                    android:layout_marginTop="4dp"
                    tools:text="Speak" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fcChatInputType"
                style="@style/FcInputButton"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:paddingTop="13dp"
                android:paddingBottom="9dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/fc_icon_keyboard" />
                <TextView
                    android:id="@+id/fcChatInputTypeLabel"
                    style="@style/FcInputButtonLabel"
                    android:layout_marginTop="4dp"
                    tools:text="Type" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Answer-generation tip carousel (2.0.0) — app parity with `ChatLoadingContent` /
      `ChatThreadContent`, where `Tips` is a bottom-anchored overlay OUTSIDE the message list.

      A direct child of the root FrameLayout so it can sit over the message area, and declared
      BEFORE the composer / overlays / toast so those still draw above it. Gone until an answer
      is generating; see ChatFragment.observeState.
    -->
    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.TipsCarouselView
        android:id="@+id/fcChatTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!--
      Unified input composer (2.0.0) — camera / text field / mic-or-send.

      Shown INSTEAD of fcChatInputButtons when `config.enableAgenticChat` is on (Compose parity:
      ChatScreen's `isComposerUi` branch). It is a direct child of the root FrameLayout, i.e. the
      SAME nesting level as fcChatOverlays below, because it seats itself from the ROOT window
      insets — a sibling of the `fitsSystemWindows="true"` LinearLayout above sees zeroed
      dispatched insets, which is exactly why InputOverlaysController reads root insets too.
      Declared BEFORE the overlays so the photo/voice panels still draw over it.
    -->
    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.InputComposerView
        android:id="@+id/fcChatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <include
        android:id="@+id/fcChatOverlays"
        layout="@layout/fc_view_input_overlays" />

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ToastView
        android:id="@+id/fcChatToast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="100dp"
        android:visibility="gone" />
</FrameLayout>
