<?xml version="1.0" encoding="utf-8"?>
<!-- App parity: AuthScreen.kt `CountryPickerScreen`.
     DefaultAppBar (Close, round chip, no glow) → LazyColumn(horizontal 20dp, top 16dp,
     spacedBy 6dp) whose FIRST item is the search field (it scrolls with the list) → a fixed
     surfaceSecondary bottom area (24dp sides, 12dp top, 40dp bottom) holding a 56dp
     PrimaryButton. The previous version was a different design: dark-on-grey 56dp bar with a
     back arrow, a pinned search box, plain RadioButton rows with no card or flag. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fcCountryPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_surface_primary"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/fcCountryPickerAppBar"
        layout="@layout/fc_view_appbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fcCountryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fc_surface_secondary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp">

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
            android:id="@+id/fcCountrySaveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp" />
    </FrameLayout>
</LinearLayout>
