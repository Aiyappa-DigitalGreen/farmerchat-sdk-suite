<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_surface_primary"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Auth hand-rolled its own 56dp app bar with dark-on-white colours, so it was the only
         screen in the flavour whose bar was NOT the brand green one every other screen shows
         (compose uses the shared `DefaultAppBar` here too — AuthScreen.kt:316). Swapped to the
         shared include; the close glyph and title are set in AuthFragment. -->
    <include
        android:id="@+id/fcAuthAppBar"
        layout="@layout/fc_view_appbar" />

    <ViewFlipper
        android:id="@+id/fcAuthFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: phone entry. App parity: AuthScreen.kt Column(horizontal 20dp, top 32dp,
             bottom 24dp) + PhoneEntryContent / AgreementCard / AuthConsentText. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <!-- titleLarge 22/28 w700 -->
                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcPhoneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:fcTextColor="@color/fc_foreground_primary"
                    app:fcTextSizeSp="22"
                    app:fcLineHeightSp="28"
                    app:fcTextWeight="700"
                    app:fcTextAlign="center" />

                <!-- bodyMedium 17/25 -->
                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcPhoneSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    app:fcTextColor="@color/fc_foreground_secondary"
                    app:fcTextSizeSp="17"
                    app:fcLineHeightSp="25"
                    app:fcTextAlign="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- CountryCodeSelector: 56dp, min 90dp, surfaceSecondary + 0.5dp
                         borderDefault, 10dp sides, 6dp gaps, 20dp flag, bodyMedium code.
                         No dropdown glyph in the app. -->
                    <LinearLayout
                        android:id="@+id/fcCountrySelector"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:minWidth="90dp"
                        android:background="@drawable/fc_bg_country_selector"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/fcCountryFlag"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fc_flag_india" />

                        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                            android:id="@+id/fcCountryCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            app:fcMaxLines="1"
                            app:fcTextColor="@color/fc_foreground_primary"
                            app:fcTextSizeSp="17"
                            app:fcLineHeightSp="25" />

                        <ProgressBar
                            android:id="@+id/fcCountryLoading"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:indeterminateTint="@color/fc_border_active"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- TextInput: OutlinedTextField (56dp), bodyLarge 19sp, placeholder in
                         foregroundSecondary, 1dp borderDefault / borderActive when focused. -->
                    <EditText
                        android:id="@+id/fcPhoneInput"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/fc_bg_text_input"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/fc_foreground_primary"
                        android:textColorHint="@color/fc_foreground_secondary"
                        android:textSize="19sp"
                        tools:hint="00000 00000" />
                </LinearLayout>

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcPhoneError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:fcTextColor="@color/fc_error"
                    android:visibility="gone"
                    app:fcTextSizeSp="13" />

                <!-- AgreementCard: Neutral200, Radius.LG, 18dp x 12dp. Texts have a bare
                     fontSize, so they inherit LocalTextStyle (bodyLarge, 27sp line height);
                     colours are hard black in the app. -->
                <LinearLayout
                    android:id="@+id/fcAgreementCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fc_bg_agreement_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp">

                    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                        android:id="@+id/fcAgreementTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:fcTextColor="@color/fc_black"
                        app:fcTextSizeSp="18"
                        app:fcLineHeightSp="27"
                        app:fcLineHeightUntrimmed="true"
                        app:fcTextWeight="700" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            app:fcText="•"
                            app:fcTextColor="@color/fc_black"
                            app:fcTextSizeSp="15"
                            app:fcLineHeightSp="27"
                        app:fcLineHeightUntrimmed="true" />

                        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                            android:id="@+id/fcAgreementPoint1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:fcTextColor="@color/fc_black"
                            app:fcTextSizeSp="15"
                            app:fcLineHeightSp="27"
                        app:fcLineHeightUntrimmed="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                            android:layout_width="16dp"
                            android:layout_height="wrap_content"
                            app:fcText="•"
                            app:fcTextColor="@color/fc_black"
                            app:fcTextSizeSp="15"
                            app:fcLineHeightSp="27"
                        app:fcLineHeightUntrimmed="true" />

                        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                            android:id="@+id/fcAgreementPoint2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:fcTextColor="@color/fc_black"
                            app:fcTextSizeSp="15"
                            app:fcLineHeightSp="27"
                        app:fcLineHeightUntrimmed="true" />
                    </LinearLayout>

                    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                        android:id="@+id/fcAgreementInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:fcTextColor="@color/fc_black"
                        app:fcTextSizeSp="14"
                        app:fcLineHeightSp="27"
                        app:fcLineHeightUntrimmed="true"
                        app:fcTextItalic="true"
                        app:fcTextWeight="700" />
                </LinearLayout>

                <!-- Send buttons: 48dp, 8dp apart, 12dp below the card; enabled only when
                     the number is valid (app `canSend`). -->
                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
                    android:id="@+id/fcWhatsappButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
                    android:id="@+id/fcSmsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp" />

                <!-- AuthConsentText: BasicText 15sp w400, centred, foregroundSecondary.
                     Stays a TextView for the clickable Privacy Policy span. -->
                <TextView
                    android:id="@+id/fcAuthConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/fc_foreground_secondary"
                    android:textSize="15sp"
                    android:textAlignment="center" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcAuthLegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:visibility="gone"
                    app:fcTextColor="@color/fc_foreground_secondary"
                    app:fcTextSizeSp="12"
                    app:fcTextAlign="center" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: OTP entry -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcOtpTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:fcTextColor="@color/fc_foreground_primary"
                    app:fcTextSizeSp="22"
                    app:fcTextWeight="700"
                    app:fcTextAlign="center" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcOtpSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    app:fcTextColor="@color/fc_foreground_secondary"
                    app:fcTextSizeSp="17"
                    app:fcTextAlign="center" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.OtpView
                    android:id="@+id/fcOtpView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcOtpError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:fcTextColor="@color/fc_error"
                    android:visibility="gone"
                    app:fcTextSizeSp="13" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
                    android:id="@+id/fcVerifyButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" />

                <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                    android:id="@+id/fcOtpTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/fc_icon_timer"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/fc_foreground_secondary"
                    android:gravity="center_vertical"
                    app:fcTextColor="@color/fc_foreground_secondary"
                    app:fcTextSizeSp="14"
                    app:fcTextAlign="center" />

                <LinearLayout
                    android:id="@+id/fcOtpResendRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                        android:id="@+id/fcResendButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fc_bg_secondary_button"
                        android:gravity="center"
                        android:padding="14dp"
                        app:fcTextColor="@color/fc_foreground_primary"
                        app:fcTextSizeSp="16"
                        app:fcTextAlign="center" />

                    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.FcText
                        android:id="@+id/fcStartOverButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:padding="14dp"
                        app:fcTextColor="@color/fc_green700"
                        app:fcTextSizeSp="16"
                        app:fcTextWeight="700"
                        app:fcTextAlign="center" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ToastView
        android:id="@+id/fcAuthToast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />
</LinearLayout>
