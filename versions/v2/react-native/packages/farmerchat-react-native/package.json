{
  "name": "@digitalgreenorg/farmerchat-react-native",
  "version": "2.2.0",
  "description": "FarmerChat full-app SDK for React Native / Expo — AI agronomy chatbot for farmers by Digital Green.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.json --removeComments --declaration false --declarationMap false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --import ./test/ts-extension-hook.mjs test/locationWire.test.ts && node --import ./test/ts-extension-hook.mjs test/appParity.test.ts && node --import ./test/ts-extension-hook.mjs test/agenticFinalText.test.ts && node --import ./test/ts-extension-hook.mjs test/chatWire.test.ts && node --import ./test/ts-extension-hook.mjs test/sendQueryAndExif.test.ts && node --import ./test/ts-extension-hook.mjs test/optionalPeers.test.ts && node --import ./test/ts-extension-hook.mjs test/profile.test.ts && node --import ./test/ts-extension-hook.mjs test/markdownBlocks.test.ts && node --import ./test/ts-extension-hook.mjs --import ./test/native-stubs-hook.mjs test/agenticIdle.test.ts && node --import ./test/ts-extension-hook.mjs test/config.test.ts && node --import ./test/ts-extension-hook.mjs --import ./test/native-stubs-hook.mjs test/lifecycle.test.ts",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "size:check": "node scripts/size-check.mjs",
    "docs": "typedoc"
  },
  "keywords": [
    "farmerchat",
    "digital-green",
    "agriculture",
    "chatbot",
    "react-native",
    "expo",
    "sdk"
  ],
  "author": "Digital Green",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalgreenorg/farmerchat-sdk-suite.git",
    "directory": "versions/v2/react-native/packages/farmerchat-react-native"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.23.0",
    "@react-navigation/drawer": ">=6.7.0",
    "@react-navigation/native": ">=6.1.0",
    "@react-navigation/native-stack": ">=6.11.0",
    "expo-av": ">=14.0.0",
    "expo-constants": ">=16.0.0",
    "expo-device": ">=6.0.0",
    "expo-image-manipulator": ">=12.0.0",
    "expo-image-picker": ">=15.0.0",
    "expo-localization": ">=16.0.0",
    "expo-location": ">=17.0.0",
    "expo-sharing": ">=12.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "react-native-gesture-handler": ">=2.16.0",
    "react-native-reanimated": ">=3.10.0",
    "react-native-safe-area-context": ">=4.10.0",
    "react-native-screens": ">=3.31.0",
    "react-native-view-shot": ">=3.8.0",
    "react-native-webview": ">=13.8.0"
  },
  "peerDependenciesMeta": {
    "expo-image-manipulator": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@types/react": "~18.3.12",
    "expo-av": "~15.0.2",
    "expo-constants": "~17.0.4",
    "expo-device": "~7.0.2",
    "expo-image-picker": "~16.0.4",
    "expo-location": "~18.0.5",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.12.5",
    "typedoc": "^0.28.20",
    "typescript": "~5.3.3"
  }
}
