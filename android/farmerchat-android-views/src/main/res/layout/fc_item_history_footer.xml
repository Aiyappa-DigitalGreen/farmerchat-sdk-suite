<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <ProgressBar
        android:id="@+id/fcHistoryFooterProgress"
        android:layout_width="24dp"
        android:layout_height="24dp" />

    <TextView
        android:id="@+id/fcHistoryFooterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/fc_foreground_secondary"
        android:textSize="13sp"
        tools:text="Loading more..." />

    <TextView
        android:id="@+id/fcHistoryFooterRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:textColor="@color/fc_green700"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Try again" />
</LinearLayout>
