<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_green700"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/fcChooserAppBar"
        layout="@layout/fc_view_appbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fc_surface_primary">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fcChooserList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.LogoSpinnerView
            android:id="@+id/fcChooserLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fc_surface_primary"
        android:orientation="vertical">

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
            android:id="@+id/fcChooserSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="20dp" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ToastView
            android:id="@+id/fcChooserToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
