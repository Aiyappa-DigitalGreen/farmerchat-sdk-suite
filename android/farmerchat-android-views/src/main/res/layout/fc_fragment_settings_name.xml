<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_green700"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/fcSettingsNameAppBar"
        layout="@layout/fc_view_appbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fc_surface_primary"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/fcSettingsNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fc_bg_input_field"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:padding="16dp"
            android:textColor="@color/fc_foreground_primary"
            android:textColorHint="@color/fc_foreground_tertiary"
            android:textSize="16sp"
            android:importantForAutofill="no"
            tools:hint="Enter your name" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.PrimaryButtonView
            android:id="@+id/fcSettingsNameSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <org.digitalgreen.farmerchat.sdk.views.internal.widgets.ToastView
            android:id="@+id/fcSettingsNameToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
