<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="18dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/fc_logo_mark"
        app:tint="@color/fc_foreground_primary" />

    <TextView
        android:id="@+id/fcLanguageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/fc_foreground_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="Choose your language" />

    <TextView
        android:id="@+id/fcLanguageSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/fc_foreground_secondary"
        android:textSize="17sp"
        tools:text="You can change this later" />
</LinearLayout>
